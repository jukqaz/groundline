{
  "identifier": "main",
  "description": "Only the bundled main window can use typed GroundLine operations.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-snapshot",
    "allow-check-connection",
    "allow-connect",
    "allow-set-collection",
    "allow-export-compose",
    "allow-core-diagnostic",
    "allow-open-dashboard",
    "allow-cancel-connection",
    "allow-resume-collection",
    "allow-save-dashboard",
    "allow-reveal-export",
    "allow-get-app-preferences",
    "allow-save-app-preferences",
    "allow-usage-summary",
    "allow-server-health",
    "allow-export-diagnostics",
    "core:app:allow-set-app-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
